<section class="payment-trust">
  <div class="container payment-trust__inner">
    <h2>{{ section.settings.payment_heading }}</h2>
    <div class="payment-icons">{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag }}{% endfor %}</div>
    <div class="trust-badges">
      <span>100%<small>{{ section.settings.trust_badge_1 }}</small></span>
      <span>★<small>{{ section.settings.trust_badge_2 }}</small></span>
      <span>🚚<small>{{ section.settings.trust_badge_3 }}</small></span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Payment and trust",
  "settings": [
    {"type": "text", "id": "payment_heading", "label": "Heading", "default": "Checkout securely with"},
    {"type": "text", "id": "trust_badge_1", "label": "Trust badge 1", "default": "Guaranteed"},
    {"type": "text", "id": "trust_badge_2", "label": "Trust badge 2", "default": "Premium quality"},
    {"type": "text", "id": "trust_badge_3", "label": "Trust badge 3", "default": "Fast shipping"}
  ],
  "presets": [{"name": "Payment and trust"}]
}
{% endschema %}
