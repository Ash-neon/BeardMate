<section class="password-page">
  <div class="password-page__card">
    <a class="brand" href="{{ routes.root_url }}"><span class="brand__mark"><span>BEARD</span><strong>MATE</strong></span><small>by {{ settings.legal_business_name | default: 'ChaliseyZ Central L.L.C.' }}</small></a>
    <p class="reference-eyebrow">{{ 'password.general.eyebrow' | t }}</p>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.text }}</p>
    {% form 'storefront_password', class: 'password-form' %}
      {{ form.errors | default_errors }}
      <label for="StorefrontPassword">{{ 'password.general.password' | t }}</label>
      <input id="StorefrontPassword" type="password" name="password" autocomplete="current-password" required>
      <button class="reference-button" type="submit">{{ 'password.general.enter' | t }}</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "A cleaner grooming routine is coming"},
    {"type": "textarea", "id": "text", "label": "Text", "default": "BeardMate is getting ready to launch. Enter the store password to preview the shop."}
  ]
}
{% endschema %}
