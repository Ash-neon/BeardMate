<section class="related-products container">
  <h2>{{ section.settings.heading }}</h2>
  <div class="related-grid">
    {% for product in section.blocks %}
      <article>
        <img src="{{ product.settings.image | asset_url }}" alt="{{ product.settings.title }}" />
        <h3>{{ product.settings.title }}</h3>
        <span>{{ product.settings.price }}</span>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Related products",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "You may also like"}
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {"type": "image_picker", "id": "image", "label": "Image", "default": "gallery-1.svg"},
        {"type": "text", "id": "title", "label": "Title", "default": "BeardMate 3-in-1 Eye Cream for Men"},
        {"type": "text", "id": "price", "label": "Price", "default": "$22.66 USD"}
      ]
    }
  ],
  "presets": [
    {"name": "Related products", "category": "Homepage"}
  ]
}
{% endschema %}
