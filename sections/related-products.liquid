{% liquid
  assign related_collection = section.settings.collection
  assign related_items = related_collection.products
  if related_collection == blank
    assign related_items = collections.all.products
  endif
%}

{% if related_items != blank %}
  <section class="related-products">
    <div class="container">
      <h2>{{ section.settings.heading }}</h2>
      <div class="related-grid">
        {% for item in related_items limit: 4 %}
          {% unless item.id == product.id %}
            <a class="related-card" href="{{ item.url }}">
              <div>{% if item.featured_image != blank %}{{ item.featured_image | image_url: width: 700 | image_tag: widths: '300, 500, 700', loading: 'lazy', alt: item.title }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}</div>
              <h3>{{ item.title }}</h3>
              <p>{% if item.compare_at_price > item.price %}<s>{{ item.compare_at_price | money }}</s>{% endif %} {{ item.price | money }}</p>
            </a>
          {% endunless %}
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Related products",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "You May Also Like"},
    {"type": "collection", "id": "collection", "label": "Collection"}
  ],
  "presets": [{"name": "Related products"}]
}
{% endschema %}
