{% liquid
  assign active_product = product
  assign active_variant = active_product.selected_or_first_available_variant
%}

<section class="product-hero">
  <div class="container hero-grid">
    <div class="product-media">
      <div class="product-image-wrap">
        {% if section.settings.hero_image != blank %}
          {{ section.settings.hero_image | image_url: width: 1200 | image_tag: id: 'productMainImage', widths: '500, 800, 1000, 1200', alt: active_product.title }}
        {% elsif active_product.featured_image != blank %}
          {{ active_product.featured_image | image_url: width: 1200 | image_tag: id: 'productMainImage', widths: '500, 800, 1000, 1200', alt: active_product.title }}
        {% else %}
          <img id="productMainImage" src="{{ 'hero-trimmer.svg' | asset_url }}" alt="BeardMate vacuum beard trimmer" width="760" height="560">
        {% endif %}
      </div>
      {% if active_product.images.size > 1 %}
        <div class="product-thumbnails" aria-label="Product images">
          {% for image in active_product.images limit: 4 %}
            <button class="thumb{% if forloop.first %} active{% endif %}" type="button" data-image="{{ image | image_url: width: 1200 }}" aria-label="Show product image {{ forloop.index }}">
              {{ image | image_url: width: 240 | image_tag: alt: image.alt }}
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="product-copy">
      <p class="eyebrow"><span></span>{{ section.settings.eyebrow_text }}</p>
      <h1>{{ active_product.title | default: section.settings.heading }}</h1>
      {% if section.settings.review_count != blank %}<div class="rating-row"><span class="stars" aria-hidden="true">★★★★★</span><span>{{ section.settings.review_count }}</span></div>{% endif %}
      <p class="hero__lead">{{ active_product.description | strip_html | truncatewords: 28 | default: section.settings.lead_text }}</p>

      <div class="hero__price">
        {% if active_product != blank %}
          <span class="price-now">{{ active_variant.price | money }}</span>
          {% if active_variant.compare_at_price > active_variant.price %}<span class="price-old">{{ active_variant.compare_at_price | money }}</span>{% endif %}
        {% else %}
          <span class="price-now">{{ section.settings.price_now }}</span><span class="price-old">{{ section.settings.price_old }}</span>
        {% endif %}
        <span class="price-chip">{{ section.settings.badge_text }}</span>
      </div>

      <ul class="benefits-list">
        <li>{{ section.settings.benefit_item_1 }}</li>
        <li>{{ section.settings.benefit_item_2 }}</li>
        <li>{{ section.settings.benefit_item_3 }}</li>
      </ul>

      {% if active_product != blank %}
        {% form 'product', active_product, id: 'ProductPageForm', class: 'product-page-form' %}
          {% unless active_product.has_only_default_variant %}
            <label for="ProductVariant-{{ section.id }}">{{ 'products.product.variant' | t }}</label>
            <select id="ProductVariant-{{ section.id }}" name="id">
              {% for variant in active_product.variants %}<option value="{{ variant.id }}"{% if variant == active_variant %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} — {{ 'products.product.sold_out' | t }}{% endunless %}</option>{% endfor %}
            </select>
          {% else %}
            <input type="hidden" name="id" value="{{ active_variant.id }}">
          {% endunless %}
          <label for="ProductPageQuantity-{{ section.id }}">Quantity</label>
          <select id="ProductPageQuantity-{{ section.id }}" name="quantity"><option value="1">1</option><option value="2">2</option><option value="3">3</option></select>
          <button class="btn btn--lime" type="submit" name="add" {% unless active_variant.available %}disabled{% endunless %}>{% if active_variant.available %}{{ section.settings.cta_primary }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</button>
          {{ form | payment_button }}
        {% endform %}
      {% else %}
        <a class="btn btn--lime" href="{{ routes.all_products_collection_url }}">{{ section.settings.cta_primary }}</a>
      {% endif %}
      <button class="share-button" type="button" data-share><span aria-hidden="true">↥</span> {{ section.settings.cta_secondary }}</button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product hero",
  "settings": [
    {"type": "image_picker", "id": "hero_image", "label": "Hero image override"},
    {"type": "text", "id": "eyebrow_text", "label": "Eyebrow text", "default": "BeardMate"},
    {"type": "text", "id": "heading", "label": "Fallback heading", "default": "BeardMate 2-in-1 Vacuum Trimmer"},
    {"type": "textarea", "id": "lead_text", "label": "Fallback description", "default": "Mess-free beard trimming starts here."},
    {"type": "text", "id": "review_count", "label": "Verified review count text"},
    {"type": "text", "id": "price_old", "label": "Fallback old price", "default": "$75.00"},
    {"type": "text", "id": "price_now", "label": "Fallback price", "default": "$49.00"},
    {"type": "text", "id": "badge_text", "label": "Badge text", "default": "Save 35%"},
    {"type": "text", "id": "benefit_item_1", "label": "Benefit 1", "default": "No more messy sink cleanup"},
    {"type": "text", "id": "benefit_item_2", "label": "Benefit 2", "default": "Built-in vacuum captures trimmed hair"},
    {"type": "text", "id": "benefit_item_3", "label": "Benefit 3", "default": "Rechargeable and travel ready"},
    {"type": "text", "id": "cta_primary", "label": "Primary CTA", "default": "Add to cart"},
    {"type": "text", "id": "cta_secondary", "label": "Secondary CTA", "default": "Share"}
  ],
  "presets": [{"name": "Product hero"}]
}
{% endschema %}
