{% liquid
  assign featured_product = section.settings.product
  assign image_1 = section.settings.image_1
  assign image_2 = section.settings.image_2
  assign image_3 = section.settings.image_3
  if image_1 == blank
    assign image_1 = featured_product.images[1]
  endif
  if image_2 == blank
    assign image_2 = featured_product.images[2]
  endif
  if image_3 == blank
    assign image_3 = featured_product.images[3]
  endif
%}

<section class="product-story" id="why">
  <div class="container">
    <h2>{{ section.settings.heading }}</h2>
    <div class="product-story__grid">
      <article class="story-card">
        <div class="story-card__media">{% if image_1 != blank %}{{ image_1 | image_url: width: 1000 | image_tag: widths: '450, 700, 1000', sizes: '(min-width: 900px) 33vw, 100vw', loading: 'lazy', alt: section.settings.title_1 }}{% else %}<img src="{{ 'style-grid.svg' | asset_url }}" alt="{{ section.settings.title_1 }}" width="720" height="420" loading="lazy">{% endif %}</div>
        <div class="story-card__copy"><span>01</span><h3>{{ section.settings.title_1 }}</h3><p>{{ section.settings.text_1 }}</p></div>
      </article>
      <article class="story-card story-card--center">
        <div class="story-card__media">{% if image_2 != blank %}{{ image_2 | image_url: width: 1000 | image_tag: widths: '450, 700, 1000', sizes: '(min-width: 900px) 33vw, 100vw', loading: 'lazy', alt: section.settings.title_2 }}{% else %}<img src="{{ 'product-detail.svg' | asset_url }}" alt="{{ section.settings.title_2 }}" width="720" height="420" loading="lazy">{% endif %}</div>
        <div class="story-card__copy"><span>02</span><h3>{{ section.settings.title_2 }}</h3><p>{{ section.settings.text_2 }}</p></div>
      </article>
      <article class="story-card">
        <div class="story-card__media">{% if image_3 != blank %}{{ image_3 | image_url: width: 1000 | image_tag: widths: '450, 700, 1000', sizes: '(min-width: 900px) 33vw, 100vw', loading: 'lazy', alt: section.settings.title_3 }}{% else %}<img src="{{ 'before-after.svg' | asset_url }}" alt="{{ section.settings.title_3 }}" width="720" height="420" loading="lazy">{% endif %}</div>
        <div class="story-card__copy"><span>03</span><h3>{{ section.settings.title_3 }}</h3><p>{{ section.settings.text_3 }}</p></div>
      </article>
    </div>
    <div class="product-story__summary">{{ section.settings.summary }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Homepage product story",
  "settings": [
    {"type": "product", "id": "product", "label": "Product used for fallback images"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Finally, A Trimmer That Keeps The Sink Clean"},
    {"type": "image_picker", "id": "image_1", "label": "Image 1"},
    {"type": "text", "id": "title_1", "label": "Title 1", "default": "One trimmer. Every beard."},
    {"type": "textarea", "id": "text_1", "label": "Text 1", "default": "Dial in your preferred length for clean stubble, sharp lines, or a fuller beard."},
    {"type": "image_picker", "id": "image_2", "label": "Image 2"},
    {"type": "text", "id": "title_2", "label": "Title 2", "default": "Power that keeps up."},
    {"type": "textarea", "id": "text_2", "label": "Text 2", "default": "A high-capacity battery, travel lock, and cordless design keep every trim easy."},
    {"type": "image_picker", "id": "image_3", "label": "Image 3"},
    {"type": "text", "id": "title_3", "label": "Title 3", "default": "No more hair in your sink."},
    {"type": "textarea", "id": "text_3", "label": "Text 3", "default": "The built-in vacuum chamber captures trimmed hair while you shave."},
    {"type": "richtext", "id": "summary", "label": "Summary", "default": "<p>Our advanced grooming system <strong>captures trimmed hairs as you shave</strong>, keeping your routine clean and effortless. No mess. No cleanup.</p>"}
  ],
  "presets": [{"name": "Homepage product story"}]
}
{% endschema %}
