<section class="product-hero">
  <div class="container hero-grid">
    <div class="product-media">
      <div class="product-image-wrap">
        <img src="{{ section.settings.hero_image | asset_url }}" alt="{{ section.settings.hero_headline }}" />
      </div>
    </div>

    <div class="product-copy">
      <p class="eyebrow">{{ section.settings.eyebrow_text }}</p>
      <h1>{{ section.settings.hero_headline }}</h1>
      <p class="lead">{{ section.settings.hero_subheadline }}</p>

      <div class="price-row">
        <span class="price-old">{{ section.settings.price_old }}</span>
        <span class="price-now">{{ section.settings.price_now }}</span>
        <span class="badge sale">{{ section.settings.badge_text }}</span>
      </div>

      <div class="actions-row">
        <a href="{{ section.settings.primary_button_url }}" class="btn btn-primary large">{{ section.settings.primary_button_text }}</a>
        <a href="{{ section.settings.secondary_button_url }}" class="btn btn-secondary">{{ section.settings.secondary_button_text }}</a>
      </div>

      <ul class="benefits-list">
        <li>{{ section.settings.benefit_item_1 }}</li>
        <li>{{ section.settings.benefit_item_2 }}</li>
        <li>{{ section.settings.benefit_item_3 }}</li>
      </ul>
    </div>
  </div>
</section>

<section class="product-detail section-alt container">
  <div class="detail-grid">
    <div class="detail-copy">
      <p class="eyebrow">{{ section.settings.detail_eyebrow }}</p>
      <h2>{{ section.settings.detail_heading }}</h2>
      <p>{{ section.settings.detail_text }}</p>
      <ul class="detail-list">
        <li>{{ section.settings.detail_bullet_1 }}</li>
        <li>{{ section.settings.detail_bullet_2 }}</li>
        <li>{{ section.settings.detail_bullet_3 }}</li>
      </ul>
    </div>
    <div class="detail-media">
      <img src="{{ section.settings.detail_image | asset_url }}" alt="{{ section.settings.detail_heading }}" />
    </div>
  </div>
</section>

<section class="feature-list container">
  <h2>{{ section.settings.feature_list_heading }}</h2>
  <div class="feature-grid">
    <article>
      <h3>{{ section.settings.feature_1_title }}</h3>
      <p>{{ section.settings.feature_1_copy }}</p>
    </article>
    <article>
      <h3>{{ section.settings.feature_2_title }}</h3>
      <p>{{ section.settings.feature_2_copy }}</p>
    </article>
    <article>
      <h3>{{ section.settings.feature_3_title }}</h3>
      <p>{{ section.settings.feature_3_copy }}</p>
    </article>
    <article>
      <h3>{{ section.settings.feature_4_title }}</h3>
      <p>{{ section.settings.feature_4_copy }}</p>
    </article>
  </div>
</section>

<section class="testimonials container">
  <h2>{{ section.settings.testimonial_heading }}</h2>
  <div class="testimonials-grid">
    {% for block in section.blocks %}
      <article>
        <img src="{{ block.settings.image | asset_url }}" alt="{{ block.settings.name }}" />
        <p>{{ block.settings.quote }}</p>
        <span>{{ block.settings.name }}</span>
      </article>
    {% endfor %}
  </div>
</section>

<section class="faq section-alt">
  <div class="container faq-grid">
    <h2>{{ section.settings.faq_heading }}</h2>
    {% for block in section.blocks %}
      <div class="faq-item">
        <button class="faq-button" aria-expanded="false">{{ block.settings.question }}</button>
        <div class="faq-panel">{{ block.settings.answer }}</div>
      </div>
    {% endfor %}
  </div>
</section>

