<section class="product-benefits-wave">
  <div class="container product-benefits-wave__inner">
    <h2>{{ section.settings.heading }}</h2>
    <div class="product-benefit-list">
      <article><h3>{{ section.settings.feature_1_title }}</h3><p>{{ section.settings.feature_1_copy }}</p><span>♜ No Mess Trim</span></article>
      <article><h3>{{ section.settings.feature_2_title }}</h3><p>{{ section.settings.feature_2_copy }}</p><span>ϟ Quick Groom Routine</span></article>
      <article><h3>{{ section.settings.feature_3_title }}</h3><p>{{ section.settings.feature_3_copy }}</p><span>💧 Easy Wash Design</span></article>
      <article><h3>{{ section.settings.feature_4_title }}</h3><p>{{ section.settings.feature_4_copy }}</p><span>✈ Travel Friendly</span></article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Feature list",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Why You’ll Love It"},
    {"type": "text", "id": "feature_1_title", "label": "Feature 1 title", "default": "Mess-Free Grooming"},
    {"type": "textarea", "id": "feature_1_copy", "label": "Feature 1 copy", "default": "Keeps your sink and bathroom clean by collecting trimmed hairs while you shave."},
    {"type": "text", "id": "feature_2_title", "label": "Feature 2 title", "default": "Fast & Easy Grooming"},
    {"type": "textarea", "id": "feature_2_copy", "label": "Feature 2 copy", "default": "Trim your beard in minutes without extra cleanup afterward."},
    {"type": "text", "id": "feature_3_title", "label": "Feature 3 title", "default": "Waterproof Cleaning"},
    {"type": "textarea", "id": "feature_3_copy", "label": "Feature 3 copy", "default": "The water-resistant design makes rinsing and resetting easy after trimming."},
    {"type": "text", "id": "feature_4_title", "label": "Feature 4 title", "default": "Travel Friendly"},
    {"type": "textarea", "id": "feature_4_copy", "label": "Feature 4 copy", "default": "Rechargeable cordless design makes it easy to groom anywhere."}
  ],
  "presets": [{"name": "Feature list"}]
}
{% endschema %}
