{% if section.blocks.size > 0 %}
  <section class="feature-ticker" aria-label="Product features">
    <div class="feature-ticker__track">
      {% for repeat in (1..5) %}
        {% for block in section.blocks %}<span {{ block.shopify_attributes }}>{{ block.settings.text }}</span><i aria-hidden="true">•</i>{% endfor %}
      {% endfor %}
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Homepage ticker",
  "settings": [],
  "blocks": [
    {"type": "item", "name": "Ticker item", "settings": [{"type": "text", "id": "text", "label": "Text", "default": "Smart Grooming"}]}
  ],
  "presets": [{"name": "Homepage ticker", "blocks": [{"type": "item"}, {"type": "item"}, {"type": "item"}]}]
}
{% endschema %}
