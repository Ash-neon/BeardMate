<section class="testimonials container">
  <h2>{{ section.settings.heading }}</h2>
  <div class="testimonials-grid">
    {% for testimonial in section.blocks %}
      <article>
        <img src="{{ testimonial.settings.image | asset_url }}" alt="{{ testimonial.settings.name }} testimonial" />
        <p>{{ testimonial.settings.quote }}</p>
        <span>{{ testimonial.settings.name }}</span>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "What Our Customers Say"}
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {"type": "image_picker", "id": "image", "label": "Image", "default": "gallery-3.svg"},
        {"type": "text", "id": "quote", "label": "Quote", "default": "Work’s good and no mess, like the way to adjust height."},
        {"type": "text", "id": "name", "label": "Name", "default": "Jim S."}
      ]
    }
  ],
  "presets": [
    {"name": "Testimonials", "category": "Homepage"}
  ]
}
{% endschema %}
