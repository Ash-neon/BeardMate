<section class="store-page catalog-page">
  <div class="container">
    <div class="store-page__heading"><p class="reference-eyebrow">{{ 'collections.general.eyebrow' | t }}</p><h1>{{ 'collections.general.title' | t }}</h1></div>
    <div class="collection-grid">
      {% for collection in collections %}
        {% unless collection.handle == 'frontpage' %}
          <article class="collection-card">
            <a href="{{ collection.url }}">
              <div>{% if collection.featured_image != blank %}{{ collection.featured_image | image_url: width: 1000 | image_tag: widths: '400, 700, 1000', loading: 'lazy', alt: collection.title }}{% else %}{{ 'collection-1' | placeholder_svg_tag }}{% endif %}</div>
              <h2>{{ collection.title }}</h2>
              <p>{{ 'collections.general.product_count' | t: count: collection.products_count }}</p>
            </a>
          </article>
        {% endunless %}
      {% else %}
        <div class="empty-state"><h2>{{ 'collections.general.empty' | t }}</h2></div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "settings": []
}
{% endschema %}
