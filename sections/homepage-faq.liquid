<section class="reference-faq" id="faq">
  <div class="container reference-faq__grid">
    <div><p class="reference-eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>
    <div>
      {% for block in section.blocks %}
        <details class="reference-faq__item" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}<span aria-hidden="true">+</span></summary>
          <p>{{ block.settings.answer }}</p>
        </details>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Homepage FAQ",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Good to know"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Questions Before You Trim?"}
  ],
  "blocks": [
    {"type": "faq", "name": "FAQ item", "settings": [{"type": "text", "id": "question", "label": "Question", "default": "Does the vacuum actually collect hair?"}, {"type": "textarea", "id": "answer", "label": "Answer", "default": "The integrated vacuum pulls most trimmed hairs into the removable collection chamber while you groom."}]}
  ],
  "presets": [{"name": "Homepage FAQ", "blocks": [{"type": "faq"}, {"type": "faq"}, {"type": "faq"}]}]
}
{% endschema %}
