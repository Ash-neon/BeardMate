<section class="store-page search-page">
  <div class="container">
    <div class="store-page__heading"><p class="reference-eyebrow">BeardMate</p><h1>{{ 'search.general.title' | t }}</h1></div>
    <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
      <label class="sr-only" for="SearchInput">{{ 'search.general.label' | t }}</label>
      <input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.general.placeholder' | t }}" autocomplete="off">
      <input type="hidden" name="options[prefix]" value="last">
      <button class="reference-button" type="submit">{{ 'search.general.submit' | t }}</button>
    </form>

    {% if search.performed %}
      <p class="search-summary">{% if search.results_count == 0 %}{{ 'search.general.no_results' | t: terms: search.terms }}{% else %}{{ 'search.general.results' | t: count: search.results_count, terms: search.terms }}{% endif %}</p>
      {% paginate search.results by section.settings.results_per_page %}
        <div class="search-results">
          {% for item in search.results %}
            {% if item.object_type == 'product' %}
              {% render 'product-card', product: item %}
            {% else %}
              <article class="content-card">
                <p class="reference-eyebrow">{{ item.object_type }}</p>
                <h2><a href="{{ item.url }}">{{ item.title }}</a></h2>
                <p>{{ item.content | strip_html | truncatewords: 30 }}</p>
                <a class="text-link" href="{{ item.url }}">{{ 'search.general.read_more' | t }}</a>
              </article>
            {% endif %}
          {% endfor %}
        </div>
        {{ paginate | default_pagination }}
      {% endpaginate %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Main search",
  "settings": [
    {"type": "range", "id": "results_per_page", "label": "Results per page", "min": 8, "max": 32, "step": 4, "default": 16}
  ]
}
{% endschema %}
