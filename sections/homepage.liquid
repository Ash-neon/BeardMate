<div class="top-bar">{{ settings.announcement_text }}</div>

<header class="site-header">
  <div class="container header-inner">
    <a href="#" class="logo-link">
      <img src="{{ 'logo.svg' | asset_url }}" alt="BeardMate logo" class="logo" />
    </a>
    <nav class="primary-nav">
      <a href="#home">Home</a>
      <a href="#shop">Shop Now</a>
      <a href="#collection">The Collection</a>
      <a href="#contact">Contact Us</a>
      <a href="#order">Track Your Order</a>
    </nav>
    <div class="header-actions">
      <button class="icon-btn" aria-label="Search">🔍</button>
      <button class="icon-btn" aria-label="Account">👤</button>
      <button class="icon-btn" aria-label="Cart">🛍️</button>
    </div>
  </div>
</header>

<main>
  {% section 'hero' %}
  {% section 'product-info' %}
  {% section 'payment-trust' %}
  {% section 'feature' %}
  {% section 'product-detail' %}
  {% section 'style' %}
  {% section 'features-list' %}
  {% section 'testimonials' %}
  {% section 'faq' %}
  {% section 'related-products' %}
</main>

{% section 'footer' %}

{% schema %}
{
  "name": "Homepage",
  "settings": [],
  "presets": [{"name": "Homepage", "category": "Page"}]
}
{% endschema %}
