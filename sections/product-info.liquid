<section class="product-info">
  <div class="container product-info__inner">
    <details class="product-info__item">
      <summary><span>🔬</span>{{ section.settings.detail_title }}<i aria-hidden="true">⌄</i></summary>
      <div><p>{{ section.settings.detail_content }}</p></div>
    </details>
    <details class="product-info__item">
      <summary><span>🚚</span>{{ section.settings.shipping_title }}<i aria-hidden="true">⌄</i></summary>
      <div><p>{{ section.settings.shipping_content }}</p><a href="{{ shop.shipping_policy.url | default: '/policies/shipping-policy' }}">Read the shipping policy</a></div>
    </details>
    <details class="product-info__item">
      <summary><span>🔄</span>{{ section.settings.refund_title }}<i aria-hidden="true">⌄</i></summary>
      <div><p>{{ section.settings.refund_content }}</p><a href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}">Read the refund policy</a></div>
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Product information",
  "settings": [
    {"type": "text", "id": "detail_title", "label": "Detail heading", "default": "Product Details"},
    {"type": "textarea", "id": "detail_content", "label": "Detail text", "default": "BeardMate delivers precision trimming with a built-in vacuum chamber to capture loose hairs while you groom. Includes styling combs, USB charging cable, and cleaning brush."},
    {"type": "text", "id": "shipping_title", "label": "Shipping heading", "default": "Shipping & Delivery"},
    {"type": "textarea", "id": "shipping_content", "label": "Shipping text", "default": "Orders are normally processed within 1–2 business days. Tracking is sent as soon as your BeardMate ships."},
    {"type": "text", "id": "refund_title", "label": "Return heading", "default": "Return & Refund Policy"},
    {"type": "textarea", "id": "refund_content", "label": "Return text", "default": "Contact us within 30 days of delivery to request a return under the BeardMate satisfaction guarantee."}
  ],
  "presets": [{"name": "Product information"}]
}
{% endschema %}
