<section class="product-info container">
  <div class="tabs-grid">
    <div class="accordion">
      <button class="accordion-button active" aria-expanded="true">{{ section.settings.detail_title }}</button>
      <div class="accordion-panel" style="display:block;">
        <p>{{ section.settings.detail_content }}</p>
      </div>
    </div>
    <div class="accordion">
      <button class="accordion-button" aria-expanded="false">{{ section.settings.shipping_title }}</button>
      <div class="accordion-panel">
        <p>{{ section.settings.shipping_content }}</p>
      </div>
    </div>
    <div class="accordion">
      <button class="accordion-button" aria-expanded="false">{{ section.settings.refund_title }}</button>
      <div class="accordion-panel">
        <p>{{ section.settings.refund_content }}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product information",
  "settings": [
    {"type": "text", "id": "detail_title", "label": "Detail heading", "default": "Product Details"},
    {"type": "textarea", "id": "detail_content", "label": "Detail text", "default": "BeardMate delivers precision trimming with a built-in vacuum chamber to capture loose hairs while you groom. Includes two styling combs, USB charging cable, and travel lock."},
    {"type": "text", "id": "shipping_title", "label": "Shipping heading", "default": "Shipping & Delivery"},
    {"type": "textarea", "id": "shipping_content", "label": "Shipping text", "default": "Free shipping on all orders. Delivery in 3-5 business days with tracking available for every order."},
    {"type": "text", "id": "refund_title", "label": "Return heading", "default": "Return & Refund Policy"},
    {"type": "textarea", "id": "refund_content", "label": "Return text", "default": "30-day money-back guarantee. If you're not satisfied, return your item within 30 days for a full refund."}
  ],
  "presets": [
    {"name": "Product information", "category": "Homepage"}
  ]
}
{% endschema %}
