{% doc %}
  Renders a merchant-editable trust message for compatible theme sections.
{% enddoc %}

<div class="trust-item" {{ block.shopify_attributes }}>
  <span aria-hidden="true">{{ block.settings.icon }}</span>
  <div>
    <strong>{{ block.settings.heading }}</strong>
    {% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Trust item",
  "settings": [
    {"type": "text", "id": "icon", "label": "Icon", "default": "✓"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Secure checkout"},
    {"type": "text", "id": "text", "label": "Text", "default": "Payments are processed securely."}
  ],
  "presets": [{"name": "Trust item"}]
}
{% endschema %}
