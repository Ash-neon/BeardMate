            <img src="{{ 'gallery-1.svg' | asset_url }}" alt="Gallery image one" />
          </button>
          <button class="thumb" data-image="{{ 'gallery-2.svg' | asset_url }}" aria-label="Gallery image two">
            <img src="{{ 'gallery-2.svg' | asset_url }}" alt="Gallery image two" />
