{% layout none %}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.accent_color | default: '#b7ff3c' }}">
    <title>{{ 'gift_cards.issued.title' | t: shop: shop.name }}</title>
    {{ 'styles.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
    <style>:root{--lime:{{ settings.accent_color | default: '#b7ff3c' }};--ink:{{ settings.text_color | default: '#141713' }};--canvas:{{ settings.background_color | default: '#f6f4ec' }};}</style>
  </head>
  <body class="gift-card-page">
    <main class="gift-card-page__card">
      <div class="brand"><span class="brand__mark"><span>BEARD</span><strong>MATE</strong></span><small>by {{ settings.legal_business_name | default: 'ChaliseyZ Central L.L.C.' }}</small></div>
      <p class="reference-eyebrow">{{ 'gift_cards.issued.eyebrow' | t }}</p>
      <h1>{{ gift_card.balance | money_with_currency }}</h1>
      {% if gift_card.enabled == false or gift_card.expired %}<p class="gift-card-page__status">{{ 'gift_cards.issued.expired' | t }}</p>{% endif %}
      {% if gift_card.expires_on %}<p>{{ 'gift_cards.issued.expiration' | t: date: gift_card.expires_on | date: '%B %d, %Y' }}</p>{% endif %}
      <p>{{ 'gift_cards.issued.instructions' | t }}</p>
      <div class="gift-card-page__code">{{ gift_card.code | format_code }}</div>
      <div class="gift-card-page__actions">
        <a class="reference-button" href="{{ shop.url }}">{{ 'gift_cards.issued.shop' | t }}</a>
        <button class="btn" type="button" onclick="window.print()">{{ 'gift_cards.issued.print' | t }}</button>
      </div>
    </main>
  </body>
</html>
