<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.accent_color | default: '#b7ff3c' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>
      {{ page_title }}
      {%- unless page_title contains shop.name %} · {{ shop.name | default: 'BeardMate' }}{% endunless -%}
    </title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% else %}
      <meta name="description" content="Precision grooming without the cleanup. Meet the BeardMate vacuum trimmer.">
    {% endif %}
    {{ 'styles.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
    <style>
      :root {
        --lime: {{ settings.accent_color | default: '#b7ff3c' }};
        --ink: {{ settings.text_color | default: '#141713' }};
        --canvas: {{ settings.background_color | default: '#f6f4ec' }};
      }
    </style>
    {% if settings.custom_css != blank %}<style>{{ settings.custom_css }}</style>{% endif %}
  </head>
  <body>
    <a class="skip-link" href="#MainContent">Skip to content</a>
    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>
    <div class="toast" id="siteToast" role="status" aria-live="polite" aria-atomic="true"></div>
    <script src="{{ 'script.js' | asset_url }}" defer></script>
  </body>
</html>
